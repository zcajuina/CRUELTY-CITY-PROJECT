offset_bottom = 465.0
badge_tittle_text = "CHEATING THE NATURAL COURSE"
badge_desc_text = "Biology has failed us, the divine has become a false memory of something pure amidst the profanity of the modern world. (Obtained by performing a body reconstruction after dying.)"
